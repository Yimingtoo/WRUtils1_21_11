{
  "schemaVersion": 3,
  "id": "redstone_dust_power",
  "description": "拉杆 -> 红石粉: 拉下时 received=15，拉回后 0（验证 RedstoneMatcher）",
  "dimension": "minecraft:overworld",
  "origin": [100, 63, 200],
  "timeoutTicks": 60,
  "record": true,
  "area": {
    "input": [
      { "min": [0, 0, 0], "max": [1, 1, 0] }
    ],
    "cleanup": "clear_input",
    "forceChunks": true,
    "clearEntities": false,
    "gameRules": { "random_tick_speed": 0, "spawn_mobs": false }
  },
  "setup": [
    { "pos": [0, 0, 0], "block": "minecraft:stone" },
    { "pos": [0, 1, 0], "block": "minecraft:lever[face=floor,facing=north,powered=false]" },
    { "pos": [1, 0, 0], "block": "minecraft:stone" },
    { "pos": [1, 1, 0], "block": "minecraft:redstone_wire" }
  ],
  "steps": [
    { "action": "use", "tick": 2, "pos": [0, 1, 0], "side": "up", "hand": "main" },
    { "action": "assert", "tick": 4, "pos": [0, 1, 0],
      "expect": { "block": "minecraft:lever[powered=true]" } },
    { "action": "assert", "tick": 4, "pos": [1, 1, 0],
      "expect": { "redstone": { "mode": "received", "min": 15, "max": 15 } } },
    { "action": "use", "tick": 6, "pos": [0, 1, 0], "side": "up", "hand": "main" },
    { "action": "assert", "tick": 8, "pos": [1, 1, 0],
      "expect": { "redstone": { "mode": "received", "min": 0, "max": 0 } } }
  ]
}
